# Dual-Screener-Bot — Director digest cron (→ /etc/cron.d/dual-screener-director-digest)
#
# AUTO-GENERATED from deploy/generate_factory_crontab.py — do not edit by hand.
# Regenerate: python deploy/generate_factory_crontab.py
# install: sudo INSTALL_ROOT=... bash deploy/install_director_digest_cron.sh
# Coin-only servers: update_bitget.sh calls install_director_digest_cron.sh (no full factory-kr).
#
# user/path: ubuntu · /home/ubuntu/dante_bots/Dual-Screener-Bot

SHELL=/bin/bash
CRON_TZ=Asia/Seoul
PATH=/usr/local/bin:/usr/bin:/bin

# --- Dual North Star digest only (REPORT_BOT; factory.sh, no factory lock) ---
# deploy-watch / iv-observation = equity factory-kr only (not on coin-only Bot-2).
# Dual North Star digest — daily (REPORT_BOT)
30 19 * * *  ubuntu  cd /home/ubuntu/dante_bots/Dual-Screener-Bot && TZ=Asia/Seoul bash ./factory.sh --north-star-digest daily
# Dual North Star digest — weekly (Sat KST)
0 11 * * 6  ubuntu  cd /home/ubuntu/dante_bots/Dual-Screener-Bot && TZ=Asia/Seoul bash ./factory.sh --north-star-digest weekly
# Dual North Star digest — monthly (1st 00:05 KST)
5 0 1 * *  ubuntu  cd /home/ubuntu/dante_bots/Dual-Screener-Bot && TZ=Asia/Seoul bash ./factory.sh --north-star-digest monthly
