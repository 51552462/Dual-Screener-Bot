[Unit]
Description=Quant development autonomy control cycle (%i)
Documentation=file://@@INSTALL_ROOT@@/dev_autonomy/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=oneshot
User=@@RUN_USER@@
Group=@@RUN_USER@@
WorkingDirectory=@@INSTALL_ROOT@@
Environment=HOME=@@USER_HOME@@
Environment=PATH=@@USER_HOME@@/.local/bin:@@USER_HOME@@/.cursor/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-@@INSTALL_ROOT@@/.env
EnvironmentFile=-@@INSTALL_ROOT@@/bitget/.env
ExecStart=/bin/bash @@INSTALL_ROOT@@/deploy/entrypoints/run_dev_autonomy_service.sh %i
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
LockPersonality=true
RestrictSUIDSGID=true
UMask=0077
StandardOutput=journal
StandardError=journal

