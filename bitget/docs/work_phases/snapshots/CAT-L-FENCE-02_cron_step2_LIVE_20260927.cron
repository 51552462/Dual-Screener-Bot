CRON_TZ=UTC
PATH=/usr/local/bin:/usr/bin:/bin
# CAT-L-FENCE-02 Step2: (a) HEAVY = root + systemd-run scope+slice 1.5G/1.2G; (b)/(c) unchanged. Rollback: CAT-L-FENCE-02_cron_p0_20260927.cron

