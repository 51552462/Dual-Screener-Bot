[Unit]
Description=Bitget journal vacuum (dante-bitget-* disk guard P0-1)
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=@@INSTALL_ROOT@@
EnvironmentFile=-@@INSTALL_ROOT@@/.env
EnvironmentFile=-@@INSTALL_ROOT@@/bitget/.env
ExecStart=/bin/bash @@INSTALL_ROOT@@/bitget/deploy/scripts/bitget_journal_vacuum.sh

[Install]
WantedBy=multi-user.target
